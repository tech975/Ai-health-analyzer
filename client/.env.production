# Production Environment Variables for Client
# This file should be configured in Vercel dashboard as environment variables

# API Configuration - Update this with your Render backend URL
VITE_API_URL=https://ai-health-analyzer.onrender.com/api

# App Configuration
VITE_APP_NAME=AI Health Analyzer
VITE_APP_VERSION=1.0.0

# Performance Settings
VITE_ENABLE_PERFORMANCE_MONITORING=true   
VITE_CACHE_ENABLED=true